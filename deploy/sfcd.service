[Unit]
Description=SFCD4 Flask Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/SFCD4
Environment="DATA_DIR=/home/ubuntu/sfcd-data"
EnvironmentFile=-/home/ubuntu/SFCD4/.env
ExecStart=/home/ubuntu/SFCD4/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
